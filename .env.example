# ── Site ──────────────────────────────────────────────────────────────
# URL pública do site (SEO, sitemap, retorno do Mercado Pago)
NEXT_PUBLIC_SITE_URL=https://vocalhope.com.br

# ── Banco de dados ────────────────────────────────────────────────────
# Postgres (Neon, Supabase, Vercel Postgres…). Sem esta variável, o projeto
# usa um banco embutido em .data/ — ótimo para desenvolvimento local.
DATABASE_URL=

# Primeiro usuário do painel, criado quando ainda não existe nenhum.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Pagamentos (Mercado Pago Checkout Pro) ────────────────────────────
# Credenciais em https://www.mercadopago.com.br/developers/panel/app
# Sem o token, os pedidos são criados e o pagamento é combinado pelo WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta dos webhooks (Suas integrações → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# ── Upload de imagens ─────────────────────────────────────────────────
# Vercel Blob. Sem ele, as imagens ficam em .data/uploads (só serve para
# servidores com disco persistente, não para a Vercel).
BLOB_READ_WRITE_TOKEN=

# ── E-mail (opcional) ─────────────────────────────────────────────────
# Aviso por e-mail a cada pedido de agenda, via Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_EMAIL_TO=contato@vocalhope.com.br
CONTACT_EMAIL_FROM="Site Vocal Hope <site@vocalhope.com.br>"
