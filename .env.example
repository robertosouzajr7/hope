# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://vocalhope.com.br

# WhatsApp do grupo, só dígitos com DDI + DDD (checkout da loja e contato)
NEXT_PUBLIC_WHATSAPP=5571999999999

# Envio do formulário de agenda por e-mail via Resend (https://resend.com).
